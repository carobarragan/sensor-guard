# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# SQLite database path (file will be created automatically)
DATABASE_URL=sqlite://sensor-guard.db

# JWT secret — use a strong random value in production (>= 32 bytes)
# Generate one with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_BYTES

# JWT token expiry in hours
JWT_EXPIRY_HOURS=24

# Server bind address
BIND_ADDR=0.0.0.0:8080

# Rust log level
RUST_LOG=sensor_guard=debug,tower_http=debug
